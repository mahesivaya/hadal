# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=hadal
# Required. Left empty on purpose: docker compose refuses to start until it is set.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=hadal

# Google OAuth client, type "Web application", from
# https://console.cloud.google.com/apis/credentials. Register exactly this
# redirect URI there. Outside localhost it must be https.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://localhost:8000/api/auth/callback

# Session lifetime (seconds): idle timeout and absolute cap (max 86400).
SESSION_IDLE_SECS=1800
SESSION_ABSOLUTE_SECS=43200

# Host port nginx is published on: the app is https://localhost:8000, and
# plain HTTP to it redirects to HTTPS. Certificates: scripts/dev-certs.sh.
HTTPS_PORT=8000
# HSTS lifetime in seconds. Local default is 300 so localhost isn't pinned to
# HTTPS for long; leave unset in production (the image default is 2 years).
# HSTS_MAX_AGE=300
RUST_LOG=info

# Used by `cargo run` in backend/ for local dev (DB from `docker compose up db`).
# Postgres requires TLS; sqlx negotiates it by default on localhost.
DATABASE_URL=postgres://hadal:${POSTGRES_PASSWORD}@localhost:5432/hadal
